{
  "name": "@dsh-external/qvl-vision",
  "description": "本地 llama.cpp/Qwen3VL 或在线 OpenAI 兼容 API 的视觉识别插件：vision_recognize 工具 + 设置页（settings.section），配置存 ~/.dsh/qvl-vision.json。随 DSH web 自启。",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": { "default": "./lib/index.mjs" },
    "./client": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "cordis": "^4.0.0-rc.7"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
